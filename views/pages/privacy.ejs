            body {
                background: linear-gradient(135deg, #0a0a0a, #1a0a0a, #000000, #1a0a0a);
                background-size: 300% 300%;
                animation: bgMove 12s ease infinite;
                min-height: 100vh;
                padding-top: 110px;
                padding-left: 20px;
                padding-right: 20px;
                font-family: Arial, sans-serif;
                display: flex;
                flex-direction: column;
                justify-content: flex-start;
            }
            
            @keyframes bgMove {
                0% {
                    background-position: 0% 50%;
                }
                50% {
                    background-position: 100% 50%;
                }
                100% {
                    background-position: 0% 50%;
                }
            }
            
            .terms-box {
                background: rgba(0, 0, 0, 0.55);
                border: 1px solid rgba(228, 119, 18, 0.4);
                border-radius: 18px;
                padding: 2.3rem;
                width: 100%;
                max-width: 850px;
                color: white;
                box-shadow: 0 0 25px rgba(228, 119, 18, 0.4);
                backdrop-filter: blur(10px);
                margin: 0 auto 50px auto;
            }
            
            h1,
            h2 {
                color: #ff6b00;
                margin-bottom: 12px;
            }
            
            p,
            li {
                line-height: 1.6;
                margin-bottom: 10px;
                color: #e1e1e1;
            }
            
            ul {
                padding-left: 20px;
            }
        </style>
