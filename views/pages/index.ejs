<!doctype html>
<html lang="en">

<head>
    <%- include("../includes/header") %>
</head>

<body class="bg-black text-white">
    <div class="loading-screen" id="loadingScreen">
        <div class="loader-container">
            <div class="loader-ring"></div>
            <div class="loader-ring"></div>
            <div class="loader-logo">
                <span class="loader-text">
                    <span class="tex-white font-bold text-2xl">arena</span><span class="text-orange-500 font-bold text-2xl">X</span><span class="text-orange-500 font-bold text-2xl">pro</span>
                </span>
            </div>
        </div>
    </div>

    <div class="main-content" id="mainContent">
        <nav class="fixed top-0 left-0 w-full z-50 bg-transparent backdrop-blur-sm border-b border-white/10">
            <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
                <a href="#home" class="flex items-center">
                    <span class="text-white font-bold text-2xl">arena</span>
                    <span class="text-orange-500 font-bold text-2xl">X</span>
                    <span class="text-orange-500 font-bold text-2xl">pro</span>
                </a>
                <button class="md:hidden text-white focus:outline-none" id="mobileBtn">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                            d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
                <div class="hidden md:flex items-center space-x-8">
                    <a href="#home" class="text-white hover:text-[#ff6b00] transition">Home</a>
                    <a href="#casual-games" class="text-white hover:text-[#ff6b00] transition">Casual Games</a>
                    <button id="subscribeBtn" onclick="subscribeNow()" class="px-4 py-2 bg-orange-600 text-white rounded">
                        Subscribe Now
                    </button>
                </div>
            </div>

            <div id="mobileMenu" class="hidden md:hidden bg-black/70 backdrop-blur-md border-t border-white/10">
                <div class="flex flex-col text-white p-4 space-y-3">

                    <a href="#home" class="hover:text-[#ff6b00]">Home</a>
                    <a href="#casual-games" class="hover:text-[#ff6b00]">Casual Games</a>
                    <button id="subscribeBtn" onclick="subscribeNow()" class="px-4 py-2 bg-orange-600 text-white rounded">
                        Subscribe Now
                    </button>

                </div>
            </div>
        </nav>

        <section class="hero-slider relative h-96 md:h-[600px] slide-up">
            <div class="hero-slide active h-full flex items-center justify-center relative overflow-hidden">
                <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('/images/bg4.jpg');">
                </div>
                <div class="absolute inset-0 bg-black/50"></div>
                <div class="absolute inset-0 flex items-end justify-center">
                    <div class="text-center px-4 w-full max-w-4xl mx-auto">
                        <h1 class="text-5xl md:text-7xl font-bold mb-6 text-white drop-shadow-2xl leading-tight" id="heroTitle">
                            Epic Gaming Awaits
                        </h1>
                    </div>
                </div>
            </div>
        </section>
        <section class="quote-section py-2 relative overflow-hidden">
            <div class="max-w-4xl mx-auto px-4">
                <div id="quoteSlider" class="relative h-40 flex items-center justify-center text-center">
                    <div class="quote active">
                        <div class="quote-text">Gaming is not just a hobby, it's a lifestyle</div>
                    </div>
                    <div class="quote">
                        <div class="quote-text">Victory comes to those who never give up</div>
                    </div>
                    <div class="quote">
                        <div class="quote-text">Your skill is your real weapon</div>
                    </div>
                    <div class="quote">
                        <div class="quote-text">Play like a legend, rise like a champion</div>
                    </div>
                </div>
            </div>
        </section>

        <section class="relative bg-gradient-to-br from-gray-900 via-black to-gray-900 overflow-hidden">
            <div class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-80" style="background-image: url('/images/banner1.png');">
            </div>
            <div class="absolute inset-0 bg-black/50"></div>
            <div class="relative z-10 flex flex-col items-center justify-end text-center py-40 px-4">
                <h2 class="text-4xl md:text-6xl font-extrabold text-white drop-shadow-xl mb-4">
                    The Future of Esports
                </h2>

                <p class="text-lg md:text-2xl text-gray-200 max-w-2xl mb-16 drop-shadow-lg">
                    Join the most immersive esports experience — compete, connect, and rise to the top!
                </p>

                <div class="mt-10">
                    <a href="https://arenaxpro.gamecentric.io/login" class="bg-orange-600 text-white px-10 py-4 rounded-full font-bold text-xl hover:bg-orange-700 transition transform hover:scale-110 shadow-xl">
                        Play Now
                    </a>

                </div>
            </div>

        </section>

        <section class="py-16 px-4 bg-gray-900 slide-up" id="casual-games">
            <div class="max-w-7xl mx-auto">
                <div class="mb-16 category-section">
                    <div class="relative h-[100px] rounded-3xl overflow-hidden mb-8">
                        <div class="absolute inset-0 bg-[#ff6b00]"></div>
                        <div class="absolute inset-0 flex items-center justify-center">
                            <h3 class="text-4xl md:text-5xl font-bold text-white">Puzzle Games</h3>
                        </div>
                    </div>

                    <div id="puzzleGames" class="game-row"></div>
                </div>
                <div class="mb-16 category-section">
                    <div class="relative h-[100px] rounded-3xl overflow-hidden mb-8">
                        <div class="absolute inset-0 bg-[#ff6b00]"></div>
                        <div class="absolute inset-0 flex items-center justify-center">
                            <h3 class="text-4xl md:text-5xl font-bold text-white">Action Games</h3>
                        </div>
                    </div>

                    <div id="actionGames" class="game-row"></div>
                </div>
                <div class="mb-16 category-section">
                    <div class="relative h-[100px] rounded-3xl overflow-hidden mb-8">
                        <div class="absolute inset-0 bg-[#ff6b00]"></div>
                        <div class="absolute inset-0 flex items-center justify-center">
                            <h3 class="text-4xl md:text-5xl font-bold text-white">Strategy Games</h3>
                        </div>
                    </div>

                    <div id="strategyGames" class="game-row"></div>
                </div>
                <div class="mb-16 category-section">
                    <div class="relative h-[100px] rounded-3xl overflow-hidden mb-8">
                        <div class="absolute inset-0 bg-[#ff6b00]"></div>
                        <div class="absolute inset-0 flex items-center justify-center">
                            <h3 class="text-4xl md:text-5xl font-bold text-white">Arcade Games</h3>
                        </div>
                    </div>

                    <div id="arcadeGames" class="game-row"></div>
                </div>
            </div>
        </section>

        <section class="py-20 px-4 slide-up bg-gradient-to-br from-black via-gray-900 to-black">
            <div class="max-w-7xl mx-auto">
                <div class="grid md:grid-cols-2 gap-12 items-center bg-gradient-to-br from-gray-900 to-black rounded-3xl overflow-hidden neon-border shadow-2xl">
                    <div class="p-8 md:p-16 order-2 md:order-1">
                        <div class="inline-block mb-6">
                            <span class="bg-orange-500 text-white px-4 py-2 rounded-full font-bold text-xs uppercase tracking-wider">
                        Community
                    </span>
                        </div>

                        <h2 class="text-3xl md:text-5xl font-bold mb-6 leading-tight">
                            Join Our <span class="gradient-text">Gaming Community</span>
                        </h2>

                        <p class="text-gray-300 mb-8 text-lg leading-relaxed">
                            Connect with millions of players, join tournaments, and become part of the most exciting gaming community on the internet.
                        </p>

                        <a href="/register" class="bg-gradient-to-r from-orange-500 to-red-600 hover:from-orange-600 hover:to-red-700 text-white px-10 py-4 rounded-full font-bold text-lg transition transform hover:scale-110 shadow-2xl">
                            Get Started
                        </a>
                    </div>
                    <div class="order-1 md:order-2 w-full h-full">
                        <img src="/images/bh.jpg" alt="Gaming Community" class="w-full h-full obect-cover">
                    </div>
                </div>
        </section>

        <footer class="bg-black border-t border-gray-800 py-12 px-4">
            <div class="max-w-7xl mx-auto">

                <div class="flex justify-center mb-8">
                    <span class="text-5xl font-bold text-white">Arena</span>
                    <span class="text-5xl font-bold text-orange-500">Xpro</span>
                </div>

                <div class="border-t border-gray-800 pt-8 text-center text-gray-400" id="footerText">
                    © <span id="currentYear"></span> arena<span style="color: #ff6b00;">Xpro</span>. All rights reserved. Made for gamer lovers worldwide.
                </div>

            </div>
        </footer>

        <script>
            document.getElementById("currentYear").textContent = new Date().getFullYear();
        </script>


        <div id="gameModal" class="hidden fixed inset-0 bg-black/90 backdrop-blur-lg z-50 flex flex-col">
            <div class="flex justify-between items-center p-4 bg-gray-900 border-b border-gray-700">
                <h2 class="text-xl font-bold text-white">Game Mode</h2>
                <button onclick="closeGame()" class="text-white text-3xl">&times;</button>
            </div>

            <iframe id="gameFrame" class="flex-1 w-full" style="border:none;">
            </iframe>

            <button onclick="toggleFullscreen()" class="bg-orange-600 text-white py-3 text-xl font-bold">
                Toggle Fullscreen
            </button>
        </div>
        <div id="subscriptionModal" class="fixed inset-0 hidden bg-black/70 flex items-center justify-center z-50">

            <div class="bg-black border border-orange-500 rounded-xl p-6 max-w-sm text-center">
                <h2 class="text-xl font-bold text-orange-500 mb-3">
                    Subscription Expired
                </h2>

                <p class="text-gray-300 mb-4">
                    Your subscription has expired.<br> Kindly subscribe to play the game.
                </p>

                <div class="flex justify-center gap-3">
                    <button id="subscribeBtn" onclick="createNewInvoice()" class="px-4 py-2 bg-orange-600 text-white rounded">
                Subscribe Now
            </button>

                    <button onclick="closeSubscriptionModal()" class="px-4 py-2 bg-gray-700 text-white rounded">
                Close
            </button>
                </div>
            </div>
        </div>

        <script>
            async function createNewInvoice() {
                const btn = document.getElementById("subscribeBtn");
                btn.disabled = true;
                btn.textContent = "Processing...";

                try {
                    const response = await fetch("/new-invoice", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        }
                    });
                    const data = await response.json();
                    localStorage.setItem("otp_verify_data", JSON.stringify(data.data));
                    if (!data.status) {
                        btn.disabled = false;
                        btn.textContent = "Subscribe Now";
                        alert(data.message || "Something went wrong");
                        return;
                    }
                    window.location.href = data.redirect;

                } catch (err) {
                    console.error(err);
                    btn.disabled = false;
                    btn.textContent = "Subscribe Now";
                }
            }

            function closeSubscriptionModal() {
                document.getElementById("subscriptionModal").classList.add("hidden");
            }
        </script>

        <script>
            function goToAccount() {
                window.location.href = "/my-account";
            }

            function logoutUser() {
                localStorage.removeItem("auth_token");
                window.location.reload();
            }

            function closeGame() {
                document.getElementById("gameModal").classList.add("hidden");
                document.getElementById("gameFrame").src = "";
            }

            function toggleFullscreen() {
                const frame = document.getElementById("gameFrame");

                if (!document.fullscreenElement) {
                    frame.requestFullscreen();
                } else {
                    document.exitFullscreen();
                }
            }

            const mobileBtn = document.getElementById("mobileBtn");
            const mobileMenu = document.getElementById("mobileMenu");

            mobileBtn.addEventListener("click", (e) => {
                e.stopPropagation();
                mobileMenu.classList.toggle("hidden");
            });
            const accountDropdown = document.getElementById("accountDropdown");
            const dropdownMenu = document.getElementById("dropdownMenu");

            if (accountDropdown) {
                accountDropdown.addEventListener("click", (e) => {
                    e.stopPropagation();
                    dropdownMenu.classList.toggle("hidden");
                });
            }

            document.addEventListener("click", () => {
                if (mobileMenu) mobileMenu.classList.add("hidden");
                if (dropdownMenu) dropdownMenu.classList.add("hidden");
            });
        </script>
        <script>
            window.msisdn = "<%= msisdn || '' %>";
            window.isHE = <%= isHE %>;
        </script>

</body>

</html>

</html>
