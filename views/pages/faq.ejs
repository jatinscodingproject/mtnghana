<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("../includes/header") %>

        <style>
            body {
                background: linear-gradient(135deg, #0a0a0a, #1a0a0a, #000000, #1a0a0a);
                background-size: 300% 300%;
                animation: bgMove 12s ease infinite;
                min-height: 100vh;
                padding-top: 110px;
                padding-left: 20px;
                padding-right: 20px;
                font-family: Arial, sans-serif;
                display: flex;
                flex-direction: column;
                justify-content: flex-start;
            }
            
            @keyframes bgMove {
                0% {
                    background-position: 0% 50%;
                }
                50% {
                    background-position: 100% 50%;
                }
                100% {
                    background-position: 0% 50%;
                }
            }
            
            .faq-box {
                background: rgba(0, 0, 0, 0.55);
                border: 1px solid rgba(228, 119, 18, 0.4);
                border-radius: 18px;
                padding: 2.3rem;
                width: 100%;
                max-width: 850px;
                color: white;
                box-shadow: 0 0 25px rgba(228, 119, 18, 0.4);
                backdrop-filter: blur(10px);
                margin: 0 auto;
            }
            
            h1 {
                color: #ff6b00;
                margin-bottom: 12px;
            }
            /* Accordion Styles */
            
            .accordion {
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(255, 107, 0, 0.4);
                border-radius: 10px;
                margin-bottom: 15px;
                overflow: hidden;
                cursor: pointer;
            }
            
            .accordion-header {
                padding: 15px;
                font-size: 1.15rem;
                font-weight: bold;
                color: #ff6b00;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }
            
            .accordion-header svg {
                transition: 0.3s;
            }
            
            .accordion-content {
                max-height: 0;
                overflow: hidden;
                transition: 0.35s ease;
                padding: 0 15px;
            }
            
            .accordion-content p,
            .accordion-content ul {
                color: #e1e1e1;
                padding-bottom: 15px;
                line-height: 1.6;
            }
            
            .rotate {
                transform: rotate(180deg);
            }
            
            footer {
                margin-top: 40px;
                background: rgba(0, 0, 0, 0.5);
                border-top: 1px solid rgba(255, 255, 255, 0.2);
                padding: 30px 0;
                text-align: center;
                color: #bbb;
            }
        </style>
</head>

<body>

    <nav class="fixed top-0 left-0 w-full z-50 bg-transparent backdrop-blur-sm border-b border-white/10">
        <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
            <a href="/" class="flex items-center">
                <span class="text-white font-bold text-2xl">arena</span>
                <span class="text-orange-500 font-bold text-2xl">X</span>
                <span class="text-orange-500 font-bold text-2xl">pro</span>
            </a>
            <button class="md:hidden text-white focus:outline-none" id="mobileBtn">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                            d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            <div class="hidden md:flex items-center space-x-8">
                <a href="/" class="text-white hover:text-[#ff6b00] transition">Home</a>
                <a href="/#casual-games" class="text-white hover:text-[#ff6b00] transition">Casual Games</a>
                <a href="/faq" class="text-white hover:text-[#ff6b00] transition">Help</a>
                <a href="/terms" class="text-white hover:text-[#ff6b00] transition">Terms</a>
                <a href="/privacy" class="text-white hover:text-[#ff6b00] transition">Privacy</a>

                <button id="loginBtn" onclick="window.location.href='/login'" class="px-4 py-2 bg-orange-600 text-white rounded-lg">
                        Login
                    </button>
                <div id="accountDropdown" class="hidden flex-col gap-2 relative">
                    <button class="px-4 py-2 bg-gray-700 text-white rounded-lg">
                            My Account ▾
                        </button>

                    <div class="absolute mt-2 bg-gray-800 text-white rounded-lg shadow-lg p-3 w-40 hidden" id="dropdownMenu">
                        <button onclick="goToAccount()" class="w-full text-left py-2 hover:text-orange-400">My Account</button>
                        <button onclick="logoutUser()" class="w-full text-left py-2 hover:text-orange-400">Logout</button>
                    </div>
                </div>

            </div>
        </div>

        <div id="mobileMenu" class="hidden md:hidden bg-black/70 backdrop-blur-md border-t border-white/10">
            <div class="flex flex-col text-white p-4 space-y-3">

                <a href="/" class="hover:text-[#ff6b00]">Home</a>
                <a href="/#casual-games" class="hover:text-[#ff6b00]">Casual Games</a>
                <a href="/faq" class="hover:text-[#ff6b00]">Help</a>
                <a href="/terms" class="hover:text-[#ff6b00]">Terms & Conditions</a>
                <a href="/privacy" class="hover:text-[#ff6b00]">Privacy Policy</a>

                <button id="mobileLoginBtn" onclick="window.location.href='/login'" class="mt-2 px-4 py-2 bg-orange-600 rounded-lg">
                        Login
                    </button>

                <div id="mobileAccountBox" class="hidden flex flex-col gap-2 mt-3">
                    <button onclick="goToAccount()" class="w-full text-left py-2 hover:text-orange-400">
                            My Account
                        </button>
                    <button onclick="logoutUser()" class="mt-2 px-4 py-2 bg-orange-600 rounded-lg">
                            Logout
                        </button>
                </div>
            </div>
        </div>
    </nav>

    <div class="faq-box">
        <div class="text-center mb-6">
            <span class="text-white font-bold text-4xl">Arena</span>
            <span class="text-orange-500 font-bold text-4xl">Xpro</span>
        </div>

        <h1 class="text-3xl font-bold mb-6">FAQ</h1>
        <div class="accordion">
            <div class="accordion-header">
                What is Esports?
                <svg width="24" height="24" fill="white"><path d="M12 15l-8-8h16z"/></svg>
            </div>
            <div class="accordion-content">
                <p>Esports stands for "electronic sports" — organized, competitive video gaming where players or teams face off for prizes, recognition, and rankings.</p>
            </div>
        </div>
        <div class="accordion">
            <div class="accordion-header">
                Is Esports a real sport?
                <svg width="24" height="24" fill="white"><path d="M12 15l-8-8h16z"/></svg>
            </div>
            <div class="accordion-content">
                <p>Yes. Esports is globally recognized and requires skill, strategy, teamwork, and mental agility, similar to traditional sports.</p>
            </div>
        </div>
        <div class="accordion">
            <div class="accordion-header">
                What competitive titles can I play on ArenaXPro?
                <svg width="24" height="24" fill="white"><path d="M12 15l-8-8h16z"/></svg>
            </div>
            <div class="accordion-content">
                <p>We list all available Esport titles on the ArenaXPro portal. Titles may be added or removed at our discretion.</p>
            </div>
        </div>
        <div class="accordion">
            <div class="accordion-header">
                Who can participate in Esports?
                <svg width="24" height="24" fill="white"><path d="M12 15l-8-8h16z"/></svg>
            </div>
            <div class="accordion-content">
                <p>Anyone with a passion for gaming—whether casual players, aspiring pros, content creators, or commentators.</p>
            </div>
        </div>
        <div class="accordion">
            <div class="accordion-header">
                What is Play Hub on ArenaXPro?
                <svg width="24" height="24" fill="white"><path d="M12 15l-8-8h16z"/></svg>
            </div>
            <div class="accordion-content">
                <p>Play Hub gives access to 200+ Esport titles, game tutorials, FAQs, and news.</p>
                <p>Once you understand the game, you can join tournaments and challenges.</p>
            </div>
        </div>
        <div class="accordion">
            <div class="accordion-header">
                How do I get started on ArenaXPro tournaments?
                <svg width="24" height="24" fill="white"><path d="M12 15l-8-8h16z"/></svg>
            </div>
            <div class="accordion-content">
                <p>Steps to get started:</p>
                <ul>
                    <li>Download the game</li>
                    <li>Complete tutorials</li>
                    <li>Find your Gamer ID</li>
                    <li>Open ArenaXPro and register</li>
                    <li>Play during the tournament window</li>
                </ul>
            </div>
        </div>
        <div class="accordion">
            <div class="accordion-header">
                Is there prizes involved?
                <svg width="24" height="24" fill="white"><path d="M12 15l-8-8h16z"/></svg>
            </div>
            <div class="accordion-content">
                <p>Yes. Prizes include airtime, data, loyalty points, tokens, or cash (for active subscribers only).</p>
            </div>
        </div>
        <div class="accordion">
            <div class="accordion-header">
                What equipment do I need?
                <svg width="24" height="24" fill="white"><path d="M12 15l-8-8h16z"/></svg>
            </div>
            <div class="accordion-content">
                <p><strong>PC/Console:</strong> Internet, headset, gaming setup</p>
                <p><strong>Mobile:</strong> Mid/high-end device + stable connection</p>
            </div>
        </div>
        <div class="accordion">
            <div class="accordion-header">
                Can I turn Esports into a career?
                <svg width="24" height="24" fill="white"><path d="M12 15l-8-8h16z"/></svg>
            </div>
            <div class="accordion-content">
                <p>Yes — Pro player, coach, content creator, analyst, team owner, event organizer.</p>
            </div>
        </div>
        <div class="accordion">
            <div class="accordion-header">
                Is Esports safe for kids?
                <svg width="24" height="24" fill="white"><path d="M12 15l-8-8h16z"/></svg>
            </div>
            <div class="accordion-content">
                <p>Yes, with parental supervision. Most games offer parental controls.</p>
            </div>
        </div>

        <!-- 11 -->
        <div class="accordion">
            <div class="accordion-header">
                What’s the difference between Esports and casual gaming?
                <svg width="24" height="24" fill="white"><path d="M12 15l-8-8h16z"/></svg>
            </div>
            <div class="accordion-content">
                <p>Casual gaming is recreational. Esports is skill-based, competitive, structured, and ranked.</p>
            </div>
        </div>

        <div class="accordion">
            <div class="accordion-header">
                How To Cancel Recurrring Invoice?
                <svg width="24" height="24" fill="white"><path d="M12 15l-8-8h16z"/></svg>
            </div>
            <div class="accordion-content">
                <p>For Cancelling Invocie Kindly drop a mail on support1@arebeesworld.com in 24 hrs the invoice will get cancelled</p>
            </div>
        </div>

    </div>
    <footer class="bg-black border-t border-gray-800 py-12 px-4">
        <div class="max-w-7xl mx-auto">

            <div class="flex justify-center mb-8">
                <span class="text-5xl font-bold text-white">Arena</span>
                <span class="text-5xl font-bold text-orange-500">Xpro</span>
            </div>

            <div class="border-t border-gray-800 pt-8 text-center text-gray-400">
                © <span id="currentYear"></span> arena<span style="color:#ff6b00;">Xpro</span>. All rights reserved. Made for gamer lovers worldwide.
            </div>

        </div>
    </footer>

    <script>
        document.getElementById("currentYear").textContent = new Date().getFullYear();
    </script>

    <script>
        const accordions = document.querySelectorAll(".accordion");

        accordions.forEach(acc => {
            const header = acc.querySelector(".accordion-header");
            const content = acc.querySelector(".accordion-content");
            const icon = header.querySelector("svg");

            header.addEventListener("click", () => {
                const isOpen = content.style.maxHeight;

                document.querySelectorAll(".accordion-content").forEach(c => c.style.maxHeight = null);
                document.querySelectorAll(".accordion-header svg").forEach(i => i.classList.remove("rotate"));

                if (!isOpen) {
                    content.style.maxHeight = content.scrollHeight + "px";
                    icon.classList.add("rotate");
                }
            });
        });
    </script>

</body>

</html>